# Base URL of the trusted platform backend. Defaults to /api (proxied by Vite).
VITE_API_BASE=/api
# Where the Vite dev server proxies /api to.
VITE_BACKEND_URL=http://127.0.0.1:8000
# "live" (default) calls the real runner. "preview" uses a clearly labelled
# simulator that does NOT execute learner code — for UI walkthroughs only.
VITE_RUNNER_MODE=live
