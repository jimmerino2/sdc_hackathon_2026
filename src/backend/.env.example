SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=grafilab/deepseek-v4-flash
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Which backend builds roadmaps (POST /roadmap). Only OPENROUTER for now.
AI_MODEL_MODE=OPENROUTER
# Needed by POST /roadmap, which writes to Supabase. Service-role key, keep it out of git.
SUPABASE_SERVICE_KEY=
# Gateway for roadmap generation. Default is the Grafilab gateway; for an openrouter.ai key use
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1 and OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://llm.grafilab.ai/v1
# Roadmap generation speed/quality: off (~12s), low (~60s, better ordering), default (~2min)
ROADMAP_REASONING=off
# Bonus Quests (tech roadmaps): reasoning for writing and judging them (off / low / default), and an optional GitHub
# token for reading submitted repos (any token with public read; without one GitHub allows ~30 submissions an hour)
CHALLENGE_REASONING=off
GITHUB_TOKEN=
# Resume skill detection (OpenJev, a model hosted on RunPod Serverless). Leave both empty to use the LLM gateway only.
# URL is the endpoint's base address, e.g. https://<endpoint-id>.api.runpod.ai (no trailing path).
# TOKEN is a RunPod API key (rpa_...): RunPod checks it before a request reaches OpenJev. Keep it out of git, and
# prefer a key limited to Serverless endpoints. A cold endpoint takes minutes to wake, so until it is ready resumes
# are scored by the LLM gateway instead.
OPENJEV_URL=
OPENJEV_TOKEN=
