SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gemini/gemini-3.1-flash-lite-preview
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Which backend builds roadmaps (POST /roadmap). Only OPENROUTER for now.
AI_MODEL_MODE=OPENROUTER
# Needed by POST /roadmap, which writes to Supabase. Service-role key, keep it out of git.
SUPABASE_SERVICE_KEY=
# Gateway for roadmap generation. Default is the Grafilab gateway; for an openrouter.ai key use
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1 and OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://llm.grafilab.ai/v1
# Roadmap generation speed/quality: off (~12s), low (~60s, better ordering), default (~2min)
ROADMAP_REASONING=off
# Bonus Quests (tech roadmaps): reasoning for writing and judging them (off / low / default), and an optional GitHub
# token for reading submitted repos (any token with public read; without one GitHub allows ~30 submissions an hour)
CHALLENGE_REASONING=off
# The score (1-100) a challenge stage must reach to pass and earn a stinger; 85 if unset
CHALLENGE_PASS_SCORE=85
GITHUB_TOKEN=

# "Post to LinkedIn" on the Learn page, shown once a role is complete. Create an app at developer.linkedin.com, link it to a LinkedIn Page,
# add the products "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn", and register the redirect URI below in the app.
# Leave these empty to hide the Post button; Copy text, Download image and Open LinkedIn still work. Keep the secret out of git.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/linkedin/callback
# Where the browser returns after LinkedIn (the Learn page of the frontend)
# LINKEDIN_API_VERSION=   (YYYYMM; leave empty: Jobee finds a version LinkedIn still serves)
LINKEDIN_RETURN_URL=http://localhost:5173/pathway

# LLM forecast benchmark (src/backend/llm_bench, page /benchmark). Separate from OPENROUTER_API_KEY above, which points
# at the Grafilab gateway: this one is an openrouter.ai key (https://openrouter.ai/keys). Free models need no credit.
# Set LLM_BENCH_RUNS_ENABLED=true to start, stop or resume runs locally. Leave it off on any public deployment.
LLM_BENCH_RUNS_ENABLED=false
OPENROUTER_BENCH_API_KEY=
OPENROUTER_BENCH_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BENCH_COMPARE_MODEL=qwen/qwen3.5-9b
OPENROUTER_BENCH_MAX_SPEND_USD=2.00
OPENROUTER_BENCH_BATCH_SIZE=10
OPENROUTER_BENCH_MAX_OUTPUT_TOKENS=2048
# Grafilab instead (reuses OPENROUTER_API_KEY; prices from OpenRouter's listing x margin; cost reported in MYR):
# OPENROUTER_BENCH_BASE_URL=https://llm.grafilab.ai/v1
# OPENROUTER_BENCH_MODEL=qwen/qwen3.7-flash
# OPENROUTER_BENCH_PRICE_MARGIN=1.5
# OPENROUTER_BENCH_MYR_PER_USD=4.0
